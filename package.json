{
  "name": "eutelsat-capacity-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-geo-coverage-prebuilt.mjs",
    "dev:vite-only": "vite",
    "build": "npm run sync:geo-coverage-prebuilt && vite build",
    "build:geo-coverage-prebuilt": "node scripts/build-geo-coverage-prebuilt.mjs",
    "sync:geo-coverage-prebuilt": "node scripts/sync-geo-coverage-prebuilt.mjs",
    "sync:geo-coverage-prebuilt:watch": "node scripts/sync-geo-coverage-prebuilt.mjs --watch",
    "fetch:frequency-plans": "node scripts/fetch-frequency-plans.mjs",
    "fetch:frequency-plans:force": "node scripts/fetch-frequency-plans.mjs --force",
    "discover:lyngsat-registry": "node scripts/discover-lyngsat-registry.mjs",
    "generate:frequency-registry": "node scripts/generate-frequency-registry.mjs",
    "generate:frequency-registry:validate": "node scripts/generate-frequency-registry.mjs --validate",
    "build:frequency-plans": "node scripts/build-frequency-plans.mjs",
    "refresh:frequency-plans": "node scripts/generate-frequency-registry.mjs --validate && node scripts/fetch-frequency-plans.mjs && node scripts/build-frequency-plans.mjs",
    "build:regulatory-overlay": "node scripts/build-regulatory-overlay.mjs",
    "generate:fill-rate-grid": "node scripts/generate-fill-rate-grid.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:perf": "node scripts/run-perf-tests.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@types/leaflet": "^1.9.21",
    "cesium": "^1.142.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.8.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resium": "1.20.0",
    "satellite.js": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
