% R29 scenario B - the R28 datum end to end: J2 dynamics at mean SMA 7578.137.
% Two-body only: the orbit is then exactly circular at r = SMA, so the geodetic
% altitude at an equator crossing is exactly SMA - WGS84 equatorial radius.
% If altitudeKm means "height above R_eq", 7578.137 must read 1200.000 there.
Create Spacecraft sat
sat.DateFormat = UTCGregorian
sat.Epoch = '06 Aug 2026 00:00:00.000'
sat.CoordinateSystem = EarthMJ2000Eq
sat.DisplayStateType = Keplerian
sat.SMA = 7586.8340
sat.ECC = 0.0
sat.INC = 87.9
sat.RAAN = 0
sat.AOP = 0
sat.TA = 0

Create ForceModel fm
fm.PrimaryBodies = {Earth}
fm.GravityField.Earth.PotentialFile = 'JGM2.cof'
fm.GravityField.Earth.Degree = 2
fm.GravityField.Earth.Order = 0
fm.GravityField.Earth.TideModel = 'None'
fm.Drag.AtmosphereModel = None
fm.PointMasses = {}
fm.SRP = Off

Create Propagator prop
prop.FM = fm
prop.Type = RungeKutta89
prop.InitialStepSize = 30
prop.Accuracy = 1e-13
prop.MinStep = 0
prop.MaxStep = 30

Create ReportFile rf
rf.Filename = '/tmp/datumB.txt'
rf.WriteHeaders = true
rf.Precision = 14
rf.Add = {sat.ElapsedSecs, sat.EarthFixed.X, sat.EarthFixed.Y, sat.EarthFixed.Z, sat.BrouwerLongSMA}

Create Variable i
BeginMissionSequence;
Report rf sat.ElapsedSecs sat.EarthFixed.X sat.EarthFixed.Y sat.EarthFixed.Z sat.BrouwerLongSMA
For i = 1:1:8640
   Propagate prop(sat) {sat.ElapsedSecs = 30}
   Report rf sat.ElapsedSecs sat.EarthFixed.X sat.EarthFixed.Y sat.EarthFixed.Z sat.BrouwerLongSMA
EndFor
