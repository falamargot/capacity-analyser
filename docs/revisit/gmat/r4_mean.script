%  R4: same run, but reporting Brouwer MEAN elements alongside osculating.
%  The engine's J2 model is secular-only, i.e. it works in mean elements.
Create Spacecraft sat
sat.DateFormat        = UTCGregorian
sat.Epoch             = '06 Aug 2026 00:00:00.000'
sat.CoordinateSystem  = EarthMJ2000Eq
sat.DisplayStateType  = Keplerian
sat.SMA               = 7571
sat.ECC               = 0.0000001
sat.INC               = 87.9
sat.RAAN              = 0
sat.AOP               = 0
sat.TA                = 0

Create ForceModel fm
fm.PrimaryBodies                    = {Earth}
fm.GravityField.Earth.PotentialFile = 'JGM2.cof'
fm.GravityField.Earth.Degree        = 2
fm.GravityField.Earth.Order         = 0
fm.GravityField.Earth.TideModel     = 'None'
fm.Drag.AtmosphereModel             = None
fm.PointMasses                      = {}
fm.SRP                              = Off

Create Propagator prop
prop.FM              = fm
prop.Type            = RungeKutta89
prop.InitialStepSize = 30
prop.Accuracy        = 1e-12
prop.MinStep         = 0
prop.MaxStep         = 60

Create ReportFile rf
rf.Filename     = '/tmp/r4_mean.txt'
rf.WriteHeaders = true
rf.Precision    = 14
rf.Add = {sat.ElapsedSecs, sat.BrouwerShortSMA, sat.BrouwerShortRAAN, sat.BrouwerShortINC, sat.BrouwerLongSMA, sat.BrouwerLongRAAN, sat.BrouwerLongINC}

Create Variable i
BeginMissionSequence;

Report rf sat.ElapsedSecs sat.BrouwerShortSMA sat.BrouwerShortRAAN sat.BrouwerShortINC sat.BrouwerLongSMA sat.BrouwerLongRAAN sat.BrouwerLongINC
For i = 1:1:864
   Propagate prop(sat) {sat.ElapsedSecs = 300}
   Report rf sat.ElapsedSecs sat.BrouwerShortSMA sat.BrouwerShortRAAN sat.BrouwerShortINC sat.BrouwerLongSMA sat.BrouwerLongRAAN sat.BrouwerLongINC
EndFor
